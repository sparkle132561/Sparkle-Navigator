   "ground_truth": {
    "answer_points": [
     "_execute_tool_call 先发出 ToolExecutionStartEvent，再调用 before_tool_call。",
     "before_tool_call hook 之后才检查取消状态、查找工具并决定是否执行；该 hook 是 Tau 的通用调用前钩子，不专指授权。",
     "被阻止时会构造错误结果；无论是否真正运行工具，随后仍会调用 after_tool_call，让它处理结果与错误标记。"
    ],
    "expected_evidence": [
